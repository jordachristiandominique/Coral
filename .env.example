# These non-database settings are examples only; settings.py still uses its
# existing development values for SECRET_KEY, DEBUG, and ALLOWED_HOSTS.
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: sqlite (default) or postgresql. Only DB_* variables are loaded here.
# Set DB_ENGINE=postgresql after creating the database and application role.
DB_ENGINE=sqlite
DB_NAME=coralsense_local
DB_USER=coralsense_app
DB_PASSWORD=replace-with-a-local-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer

# Email Configuration (optional)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-password
